{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bun run lint && bun run typecheck",
            "statusMessage": "Validating lint and types..."
          }
        ]
      }
    ]
  }
}
