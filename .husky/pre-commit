#!/bin/sh

# Lint and typecheck staged code
echo "🔍 Running lint and typecheck..."
bun run lint && bun run typecheck
if [ $? -ne 0 ]; then
  echo "❌ Lint or type errors found. Fix before committing."
  exit 1
fi

# Format staged files
echo "💅 Formatting staged files..."
npx prettier --write --list-different $(git diff --staged --name-only --diff-filter=ACM "*.ts" "*.tsx" "*.js" "*.jsx" "*.json" "*.md" 2>/dev/null) 2>/dev/null || echo "✨ No files to format"
